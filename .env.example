# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me
# Leave DATABASE_URL empty to use db.sqlite3. For Postgres:
# DATABASE_URL=postgres://sneos:sneos@localhost:5432/sneos
DATABASE_URL=

APP_NAME=SN EOS
SITE_URL=http://localhost:8000
ALLOWED_EMAIL_DOMAIN=steuartnutrition.com

# Google OAuth client (Web application). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev quick login (pick a user). Ignored in production.
DEV_LOGIN=1

# Production only
# ALLOWED_HOSTS=sn-eos.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://sn-eos.up.railway.app

# Load the Tailwind CDN instead of the compiled static/css/app.css (local template work only)
# TAILWIND_CDN=1

# Optional SMTP for L10 recap emails (dev prints to the console)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SN EOS <eos@steuartnutrition.com>

# "Send to Asana" for to-dos. Same names as the Battle Planner, so the Railway values can be shared.
# Without ASANA_PAT the Asana buttons are hidden.
# ASANA_PAT=
# ASANA_PROJECT_GID=
# ASANA_WORKSPACE_GID=1201499979026080
# ASANA_TEAM_GID=1206830892890847
